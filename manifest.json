{
    "manifest_version": 3,
    "name": "LeetMemo",
    "version": "0.1.0",
    "description": "Remember your LeetCode solutions with notes and spaced-repetition review.",
    "permissions": [
        "storage", "alarms"
    ],
    "host_permissions": [
        "https://leetcode.com/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_popup": "popup.html"
    },
    "background" : {
        "service_worker" : "js/background.js",
        "type" : "module"
    }
}
